# Copy to .env at the repo root.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wildbound
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/wildbound_test

# API
API_PORT=4000
API_HOST=127.0.0.1
# Bearer token required for every /api/editor/* route and for draft-stage resolution.
EDITOR_TOKEN=dev-editor-token
# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Used to derive time-of-day when a resolve request does not pass one.
WORLD_TIMEZONE=Asia/Manila

# Editor and player web app (Vite exposes VITE_* to the browser)
VITE_API_URL=http://localhost:4000
VITE_EDITOR_TOKEN=dev-editor-token

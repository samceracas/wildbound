# Copy to .env at the repo root.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wildbound
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/wildbound_test

# API
API_PORT=4000
API_HOST=127.0.0.1
# Bearer token required for every /api/editor/* route (including coordinate preview).
EDITOR_TOKEN=dev-editor-token
# Comma separated list of allowed browser origins (the editor; the game uses the Vite proxy).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Fallback time zone for time-of-day when neither the weather service nor the browser gives one.
WORLD_TIMEZONE=Asia/Manila

# Editor, Creature Manager and player web app (Vite exposes VITE_* to the browser)
VITE_API_URL=http://localhost:4000
VITE_EDITOR_TOKEN=dev-editor-token

# Live weather for the game (Open-Meteo, no key). Set to "off" for always-clear offline development.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# Mark the player session cookie Secure (only when served over HTTPS).
SECURE_COOKIES=false

# Creature Manager AI assistant (Groq, https://console.groq.com/keys). Leave empty to disable the assistant.
GROQ_API_KEY=
# Any Groq chat model with JSON mode, e.g. llama-3.3-70b-versatile, openai/gpt-oss-120b, openai/gpt-oss-20b.
GROQ_MODEL=llama-3.3-70b-versatile
# Lore sent with each assistant request: "brief" = the condensed docs/lore/assistant-brief.md (~3,300 tokens per
# request, fits Groq's free tier); "full" = the canon docs/WILDBOUND_*.docx (~9,300 tokens).
LORE_SOURCE=brief
# Upper bound on lore characters per request (matters for LORE_SOURCE=full).
LORE_MAX_CHARS=30000

# Creature Manager art generation (PixelLab, https://pixellab.ai). Leave empty to disable the art button.
PIXELLAB_API_KEY=

# Field Registry license assessments: clamp "observe in N weathers" requirements to 1.
# Keep true while exercise #1 (weatherFromWmoCode) is open: live weather is always "clear" until then.
ASSESSMENT_RELAX_WEATHER=true

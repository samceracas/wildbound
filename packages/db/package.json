{
  "name": "@wildbound/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate:new": "prisma migrate dev --create-only",
    "studio": "prisma studio",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "reset": "tsx src/scripts/reset.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@wildbound/shared": "workspace:*",
    "@wildbound/world": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
